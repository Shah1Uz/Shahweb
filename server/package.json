{
  "name": "portfolio-cms-server",
  "version": "1.0.0",
  "description": "Production Full-Stack Programmer Portfolio CMS Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node prepare-prisma.js && tsx watch src/index.ts",
    "build": "node prepare-prisma.js && prisma generate && tsc",
    "start": "node dist/index.js",
    "postinstall": "node prepare-prisma.js && prisma generate",
    "prisma:generate": "node prepare-prisma.js && prisma generate",
    "prisma:push": "node prepare-prisma.js && prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:setup": "node prepare-prisma.js && prisma generate && prisma db push && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.0.9",
    "prisma": "^5.19.1",
    "resend": "^6.28.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "zod": "^3.23.8"
  }
}
